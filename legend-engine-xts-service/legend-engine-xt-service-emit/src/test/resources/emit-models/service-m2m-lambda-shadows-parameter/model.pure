###Pure
Class shadowParam::model::Source
{
  id: String[1];
  kind: String[1];
  tags: String[*];
  prefixed(t: String[1]) {$this.tags->map(t | $t + '-')->joinStrings($t)}: String[1];
}

Class shadowParam::model::Target
{
  id: String[1];
  matchShadow: String[1];
  mapShadow: String[*];
  qualifiedShadow: String[1];
}

function shadowParam::model::matchShadow(s: shadowParam::model::Source[1]): String[1]
{
  $s.kind->match([s: String[1] | 'inner-' + $s]);
}

function shadowParam::model::mapShadow(t: shadowParam::model::Source[1]): String[*]
{
  $t.tags->map(t | $t + 'x');
}


###Mapping
Mapping shadowParam::mapping::SourceToTarget
(
  *shadowParam::model::Target: Pure
  {
    ~src shadowParam::model::Source
    id: $src.id,
    matchShadow: $src->shadowParam::model::matchShadow(),
    mapShadow: $src->shadowParam::model::mapShadow(),
    qualifiedShadow: $src.prefixed('|')
  }
)


###Runtime
Runtime shadowParam::runtime::SourceRuntime
{
  mappings:
  [
    shadowParam::mapping::SourceToTarget
  ];
  connections:
  [
    ModelStore:
    [
      json:
      #{
        JsonModelConnection
        {
          class: shadowParam::model::Source;
          url: 'executor:default';
        }
      }#
    ]
  ];
}


###Service
Service shadowParam::service::ShadowService
{
  pattern: '/shadowParam';
  documentation: 'M2M Service Whose Lambda Parameters Reuse the Function Parameter Name';
  autoActivateUpdates: true;
  execution: Single
  {
    query: |shadowParam::model::Target.all()->graphFetch(#{shadowParam::model::Target{id,matchShadow,mapShadow,qualifiedShadow}}#)->serialize(#{shadowParam::model::Target{id,matchShadow,mapShadow,qualifiedShadow}}#);
    mapping: shadowParam::mapping::SourceToTarget;
    runtime: shadowParam::runtime::SourceRuntime;
  }
  testSuites:
  [
    shadowing:
    {
      data:
      [
        connections:
        [
          json:
            ExternalFormat
            #{
              contentType: 'application/json';
              data: '[{"id":"r1","kind":"a","tags":["t1","t2"]},{"id":"r2","kind":"b","tags":[]}]';
            }#
        ]
      ]
      tests:
      [
        generatedJavaCompiles:
        {
          serializationFormat: PURE;
          asserts:
          [
            valuesMatch:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"id":"r1","matchShadow":"inner-a","mapShadow":["t1x","t2x"],"qualifiedShadow":"t1-|t2-"},{"id":"r2","matchShadow":"inner-b","mapShadow":[],"qualifiedShadow":""}]';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
