###Pure
Class numeric::graphOutput::Source
{
  d: Decimal[1];
  n: Number[1];
  optional: Decimal[0..1];
  values: Decimal[*];
}
Class numeric::graphOutput::Target
{
  d: Decimal[1];
  n: Number[1];
  optional: Decimal[0..1];
  values: Decimal[*];
}
###Mapping
Mapping numeric::graphOutput::Mapping
(
  *numeric::graphOutput::Target: Pure
  {
    ~src numeric::graphOutput::Source
    d: $src.d,
    n: $src.n,
    optional: $src.optional,
    values: $src.values
  }
  testSuites:
  [
    outputSuite:
    {
      function: |numeric::graphOutput::Target.all()->graphFetch(#{numeric::graphOutput::Target{d, n, optional, values}}#)->serialize(#{numeric::graphOutput::Target{d, n, optional, values}}#);
      tests:
      [
        largeScale:
        {
          data: [ModelStore: ModelStore #{ numeric::graphOutput::Source: ExternalFormat #{ contentType: 'application/json'; data: '{"d":1e-10000,"n":1e-10000,"optional":null,"values":[1e10000,1e-10000,0]}'; }# }#];
          asserts: [expected: EqualToJson #{ expected: ExternalFormat #{ contentType: 'application/json'; data: '{"d":1e-10000,"n":1e-10000,"optional":null,"values":[1e10000,1e-10000,0]}'; }#; }#];
        },
        negativeScale:
        {
          data: [ModelStore: ModelStore #{ numeric::graphOutput::Source: ExternalFormat #{ contentType: 'application/json'; data: '{"d":1e10000,"n":1e10000,"optional":null,"values":[1e10000,1e-10000,0]}'; }# }#];
          asserts: [expected: EqualToJson #{ expected: ExternalFormat #{ contentType: 'application/json'; data: '{"d":1e10000,"n":1e10000,"optional":null,"values":[1e10000,1e-10000,0]}'; }#; }#];
        },
        highPrecision:
        {
          data: [ModelStore: ModelStore #{ numeric::graphOutput::Source: ExternalFormat #{ contentType: 'application/json'; data: '{"d":-1.2345678901234567890123456789e10000,"n":-1.2345678901234567890123456789e10000,"optional":null,"values":[1e10000,1e-10000,0]}'; }# }#];
          asserts: [expected: EqualToJson #{ expected: ExternalFormat #{ contentType: 'application/json'; data: '{"d":-1.2345678901234567890123456789e10000,"n":-1.2345678901234567890123456789e10000,"optional":null,"values":[1e10000,1e-10000,0]}'; }#; }#];
        }
      ];
    }
  ]
)
