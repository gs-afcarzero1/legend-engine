###Pure
Class demo::m2m::filterCast::source::S_Book
{
  name: String[1];
  trades: demo::m2m::filterCast::source::S_Trade[*];
}

Class demo::m2m::filterCast::source::S_FxBook extends demo::m2m::filterCast::source::S_Book
{
  desk: String[1];
}

Class demo::m2m::filterCast::source::S_Trade
{
  id: String[1];
}

Class demo::m2m::filterCast::source::S_FxTrade extends demo::m2m::filterCast::source::S_Trade
{
  pair: String[1];
}

Class demo::m2m::filterCast::target::Book
{
  name: String[1];
  eurTrades: demo::m2m::filterCast::target::Trade[*];
}

Class demo::m2m::filterCast::target::Trade
{
  id: String[1];
}


###Mapping
Mapping demo::m2m::filterCast::BookMapping
(
  *demo::m2m::filterCast::target::Book: Pure
  {
    ~src demo::m2m::filterCast::source::S_Book
    ~filter $src->cast(@demo::m2m::filterCast::source::S_FxBook).desk == 'FX'
    name: $src.name,
    eurTrades[eur]: $src.trades
  }

  demo::m2m::filterCast::target::Trade[eur]: Pure
  {
    ~src demo::m2m::filterCast::source::S_Trade
    ~filter $src->cast(@demo::m2m::filterCast::source::S_FxTrade).pair == 'EURUSD'
    id: $src.id
  }

  testSuites:
  [
    filterSuite:
    {
      function: |demo::m2m::filterCast::target::Book.all()->graphFetch(#{demo::m2m::filterCast::target::Book{name, eurTrades{id}}}#)->serialize(#{demo::m2m::filterCast::target::Book{name, eurTrades{id}}}#);
      tests:
      [
        filtersBySubtypeProperties:
        {
          data:
          [
            ModelStore: ModelStore
              #{
                demo::m2m::filterCast::source::S_Book:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"@type":"demo::m2m::filterCast::source::S_FxBook","name":"fx-book","desk":"FX","trades":[{"@type":"demo::m2m::filterCast::source::S_FxTrade","id":"t1","pair":"EURUSD"},{"@type":"demo::m2m::filterCast::source::S_FxTrade","id":"t2","pair":"GBPUSD"}]},{"@type":"demo::m2m::filterCast::source::S_FxBook","name":"rates-book","desk":"RATES","trades":[]}]';
                  }#
              }#
          ];
          asserts:
          [
            expected:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"name":"fx-book","eurTrades":[{"id":"t1"}]}';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
