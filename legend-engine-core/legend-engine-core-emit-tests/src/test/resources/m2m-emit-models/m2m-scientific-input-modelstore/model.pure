###Pure
Class numeric::modelstoreNumber::Source
{
  n: Number[1];
  i: Integer[1];
  f: Float[1];
  optional: Number[0..1];
  repeated: Number[*];
}
Class numeric::modelstoreNumber::Target
{
  n: Number[1];
  i: Integer[1];
  f: Float[1];
  optional: Number[0..1];
  repeated: Number[*];
  positive: Boolean[1];
  cancelled: Number[1];
}

###Mapping
Mapping numeric::modelstoreNumber::Mapping
(
  *numeric::modelstoreNumber::Target: Pure
  {
    ~src numeric::modelstoreNumber::Source
    n: $src.n,
    i: $src.i,
    f: $src.f,
    optional: $src.optional,
    repeated: $src.repeated,
    positive: $src.n > 0,
    cancelled: $src.n - $src.n
  }

  testSuites:
  [
    numericSuite:
    {
      function: |numeric::modelstoreNumber::Target.all()->graphFetch(#{numeric::modelstoreNumber::Target{n, i, f, optional, repeated, positive, cancelled}}#)->serialize(#{numeric::modelstoreNumber::Target{n, i, f, optional, repeated, positive, cancelled}}#);
      tests:
      [
        lowerExponent:
        {
          data: [ModelStore: ModelStore #{ numeric::modelstoreNumber::Source: ExternalFormat #{ contentType: 'application/json'; data: '{"n":1.25e-3,"i":1e3,"f":-2.5e1,"optional":null,"repeated":[1.25e-3,9007199254740993]}'; }# }#];
          asserts: [expected: EqualToJson #{ expected: ExternalFormat #{ contentType: 'application/json'; data: '{"n":0.00125,"i":1000,"f":-25.0,"optional":null,"repeated":[0.00125,9007199254740993],"positive":true,"cancelled":0.00000}'; }#; }#];
        },
        upperSigned:
        {
          data: [ModelStore: ModelStore #{ numeric::modelstoreNumber::Source: ExternalFormat #{ contentType: 'application/json'; data: '{"n":-1.25E+3,"i":-2E+2,"f":1.25E-3,"optional":null,"repeated":[1.25e-3,9007199254740993]}'; }# }#];
          asserts: [expected: EqualToJson #{ expected: ExternalFormat #{ contentType: 'application/json'; data: '{"n":-1.25E+3,"i":-200,"f":0.00125,"optional":null,"repeated":[0.00125,9007199254740993],"positive":false,"cancelled":0E+1}'; }#; }#];
        },
        plainEquivalent:
        {
          data: [ModelStore: ModelStore #{ numeric::modelstoreNumber::Source: ExternalFormat #{ contentType: 'application/json'; data: '{"n":0.00125,"i":1000,"f":-25.0,"optional":null,"repeated":[1.25e-3,9007199254740993]}'; }# }#];
          asserts: [expected: EqualToJson #{ expected: ExternalFormat #{ contentType: 'application/json'; data: '{"n":0.00125,"i":1000,"f":-25.0,"optional":null,"repeated":[0.00125,9007199254740993],"positive":true,"cancelled":0.00000}'; }#; }#];
        },
        zero:
        {
          data: [ModelStore: ModelStore #{ numeric::modelstoreNumber::Source: ExternalFormat #{ contentType: 'application/json'; data: '{"n":0e-3,"i":0e3,"f":0e0,"optional":null,"repeated":[1.25e-3,9007199254740993]}'; }# }#];
          asserts: [expected: EqualToJson #{ expected: ExternalFormat #{ contentType: 'application/json'; data: '{"n":0.000,"i":0,"f":0.0,"optional":null,"repeated":[0.00125,9007199254740993],"positive":false,"cancelled":0.000}'; }#; }#];
        },
        aboveDoublePrecision:
        {
          data: [ModelStore: ModelStore #{ numeric::modelstoreNumber::Source: ExternalFormat #{ contentType: 'application/json'; data: '{"n":9007199254740993,"i":9007199254740993,"f":1.0,"optional":null,"repeated":[1.25e-3,9007199254740993]}'; }# }#];
          asserts: [expected: EqualToJson #{ expected: ExternalFormat #{ contentType: 'application/json'; data: '{"n":9007199254740993,"i":9007199254740993,"f":1.0,"optional":null,"repeated":[0.00125,9007199254740993],"positive":true,"cancelled":0}'; }#; }#];
        },
        longMaximum:
        {
          data: [ModelStore: ModelStore #{ numeric::modelstoreNumber::Source: ExternalFormat #{ contentType: 'application/json'; data: '{"n":9223372036854775807,"i":9223372036854775807,"f":1.0,"optional":null,"repeated":[1.25e-3,9007199254740993]}'; }# }#];
          asserts: [expected: EqualToJson #{ expected: ExternalFormat #{ contentType: 'application/json'; data: '{"n":9223372036854775807,"i":9223372036854775807,"f":1.0,"optional":null,"repeated":[0.00125,9007199254740993],"positive":true,"cancelled":0}'; }#; }#];
        },
        longMinimum:
        {
          data: [ModelStore: ModelStore #{ numeric::modelstoreNumber::Source: ExternalFormat #{ contentType: 'application/json'; data: '{"n":-9223372036854775808,"i":-9223372036854775808,"f":-1.0,"optional":null,"repeated":[1.25e-3,9007199254740993]}'; }# }#];
          asserts: [expected: EqualToJson #{ expected: ExternalFormat #{ contentType: 'application/json'; data: '{"n":-9223372036854775808,"i":-9223372036854775808,"f":-1.0,"optional":null,"repeated":[0.00125,9007199254740993],"positive":false,"cancelled":0}'; }#; }#];
        },
        highPrecision:
        {
          data: [ModelStore: ModelStore #{ numeric::modelstoreNumber::Source: ExternalFormat #{ contentType: 'application/json'; data: '{"n":1.2345678901234567890123456789e-3,"i":1,"f":1.0,"optional":null,"repeated":[1.25e-3,9007199254740993]}'; }# }#];
          asserts: [expected: EqualToJson #{ expected: ExternalFormat #{ contentType: 'application/json'; data: '{"n":0.0012345678901234567890123456789,"i":1,"f":1.0,"optional":null,"repeated":[0.00125,9007199254740993],"positive":true,"cancelled":0E-31}'; }#; }#];
        },
        wideNumber:
        {
          data: [ModelStore: ModelStore #{ numeric::modelstoreNumber::Source: ExternalFormat #{ contentType: 'application/json'; data: '{"n":9223372036854775808,"i":1,"f":1.0,"optional":null,"repeated":[1.25e-3,9007199254740993]}'; }# }#];
          asserts: [expected: EqualToJson #{ expected: ExternalFormat #{ contentType: 'application/json'; data: '{"n":9223372036854775808,"i":1,"f":1.0,"optional":null,"repeated":[0.00125,9007199254740993],"positive":true,"cancelled":0}'; }#; }#];
        }
      ];
    }
  ]
)
