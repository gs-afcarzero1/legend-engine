###Pure
Class demo::m2m::cast::childSource::Leaf { id: String[1]; }
Class demo::m2m::cast::childSource::Detail { somevalue: String[1]; }
Class demo::m2m::cast::childSource::Special extends demo::m2m::cast::childSource::Leaf { somevalue: demo::m2m::cast::childSource::Detail[1]; }
Class demo::m2m::cast::childSource::Source { aDecoy: demo::m2m::cast::childSource::Leaf[1]; primary: demo::m2m::cast::childSource::Leaf[1]; }
Class demo::m2m::cast::childSource::Target2 { targets: demo::m2m::cast::childSource::Target[*]; }
Class demo::m2m::cast::childSource::Target { id: String[1]; val1: String[1]; }

###Mapping
Mapping demo::m2m::cast::childSource::Transform
(
  *demo::m2m::cast::childSource::Target2: Pure
  {
    ~src demo::m2m::cast::childSource::Source
    targets[target]: $src.primary
  }
  demo::m2m::cast::childSource::Target[target]: Pure
  {
    ~src demo::m2m::cast::childSource::Leaf
    id: $src.id,
    val1: $src->cast(@demo::m2m::cast::childSource::Special).somevalue.somevalue
  }
)

###Runtime
Runtime demo::m2m::cast::childSource::TransformRuntime
{
  mappings:
  [
    demo::m2m::cast::childSource::Transform
  ];
  connections:
  [
    ModelStore:
    [
      json:
      #{
        JsonModelConnection
        {
          class: demo::m2m::cast::childSource::Source;
          url: 'executor:default';
        }
      }#
    ]
  ];
}

###Service
Service demo::m2m::cast::childSource::TransformService
{
  pattern: '/m2m-child-casts-its-source';
  documentation: 'M2M child mapping reads a subtype property after casting its own source';
  autoActivateUpdates: true;
  execution: Single
  {
    query: |demo::m2m::cast::childSource::Target2.all()->graphFetch(#{demo::m2m::cast::childSource::Target2{targets{id,val1}}}#)->serialize(#{demo::m2m::cast::childSource::Target2{targets{id,val1}}}#);
    mapping: demo::m2m::cast::childSource::Transform;
    runtime: demo::m2m::cast::childSource::TransformRuntime;
  }
  testSuites:
  [
    suite:
    {
      data:
      [
        connections:
        [
          json:
            ExternalFormat
            #{
              contentType: 'application/json';
              data: '{"aDecoy":{"@type":"Special","id":"DECOY","somevalue":{"somevalue":"wrong"}},"primary":{"@type":"Special","id":"PRIMARY","somevalue":{"somevalue":"value"}}}';
            }#
        ]
      ]
      tests:
      [
        test:
        {
          serializationFormat: PURE;
          asserts:
          [
            expected:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"targets":[{"id":"PRIMARY","val1":"value"}]}';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
