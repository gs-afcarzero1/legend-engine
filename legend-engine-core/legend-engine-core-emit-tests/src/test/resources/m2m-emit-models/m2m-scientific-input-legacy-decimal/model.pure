###Pure
Class numeric::legacyDecimal::Source
{
  n: Number[1];
  i: Integer[1];
  f: Float[1];
  optional: Number[0..1];
  repeated: Number[*];
  unrelated: Decimal[0..1];
}
Class numeric::legacyDecimal::Target
{
  n: Number[1];
  i: Integer[1];
  f: Float[1];
  optional: Number[0..1];
  repeated: Number[*];
  unrelated: Decimal[0..1];
  positive: Boolean[1];
  cancelled: Number[1];
}

###Mapping
Mapping numeric::legacyDecimal::Mapping
(
  *numeric::legacyDecimal::Target: Pure
  {
    ~src numeric::legacyDecimal::Source
    n: $src.n,
    i: $src.i,
    f: $src.f,
    optional: $src.optional,
    repeated: $src.repeated,
    unrelated: $src.unrelated,
    positive: $src.n > 0,
    cancelled: $src.n - $src.n
  }

  MappingTests
  [
    lowerExponent
    (
      query: |numeric::legacyDecimal::Target.all()->graphFetch(#{numeric::legacyDecimal::Target{n, i, f, optional, repeated, unrelated, positive, cancelled}}#)->serialize(#{numeric::legacyDecimal::Target{n, i, f, optional, repeated, unrelated, positive, cancelled}}#);
      data: [<Object, JSON, numeric::legacyDecimal::Source, '{"n":1.25e-3,"i":1e3,"f":-2.5e1,"optional":null,"repeated":[1.25e-3,9007199254740993],"unrelated":1.234567890123456789}'>];
      assert: '{"n":0.00125,"i":1000,"f":-25.0,"optional":null,"repeated":[0.00125,9007199254740993],"unrelated":1.234567890123456789,"positive":true,"cancelled":0.00000}';
    ),
    upperSigned
    (
      query: |numeric::legacyDecimal::Target.all()->graphFetch(#{numeric::legacyDecimal::Target{n, i, f, optional, repeated, unrelated, positive, cancelled}}#)->serialize(#{numeric::legacyDecimal::Target{n, i, f, optional, repeated, unrelated, positive, cancelled}}#);
      data: [<Object, JSON, numeric::legacyDecimal::Source, '{"n":-1.25E+3,"i":-2E+2,"f":1.25E-3,"optional":null,"repeated":[1.25e-3,9007199254740993],"unrelated":1.234567890123456789}'>];
      assert: '{"n":-1.25E+3,"i":-200,"f":0.00125,"optional":null,"repeated":[0.00125,9007199254740993],"unrelated":1.234567890123456789,"positive":false,"cancelled":0E+1}';
    ),
    plainEquivalent
    (
      query: |numeric::legacyDecimal::Target.all()->graphFetch(#{numeric::legacyDecimal::Target{n, i, f, optional, repeated, unrelated, positive, cancelled}}#)->serialize(#{numeric::legacyDecimal::Target{n, i, f, optional, repeated, unrelated, positive, cancelled}}#);
      data: [<Object, JSON, numeric::legacyDecimal::Source, '{"n":0.00125,"i":1000,"f":-25.0,"optional":null,"repeated":[1.25e-3,9007199254740993],"unrelated":1.234567890123456789}'>];
      assert: '{"n":0.00125,"i":1000,"f":-25.0,"optional":null,"repeated":[0.00125,9007199254740993],"unrelated":1.234567890123456789,"positive":true,"cancelled":0.00000}';
    ),
    zero
    (
      query: |numeric::legacyDecimal::Target.all()->graphFetch(#{numeric::legacyDecimal::Target{n, i, f, optional, repeated, unrelated, positive, cancelled}}#)->serialize(#{numeric::legacyDecimal::Target{n, i, f, optional, repeated, unrelated, positive, cancelled}}#);
      data: [<Object, JSON, numeric::legacyDecimal::Source, '{"n":0e-3,"i":0e3,"f":0e0,"optional":null,"repeated":[1.25e-3,9007199254740993],"unrelated":1.234567890123456789}'>];
      assert: '{"n":0.000,"i":0,"f":0.0,"optional":null,"repeated":[0.00125,9007199254740993],"unrelated":1.234567890123456789,"positive":false,"cancelled":0.000}';
    ),
    aboveDoublePrecision
    (
      query: |numeric::legacyDecimal::Target.all()->graphFetch(#{numeric::legacyDecimal::Target{n, i, f, optional, repeated, unrelated, positive, cancelled}}#)->serialize(#{numeric::legacyDecimal::Target{n, i, f, optional, repeated, unrelated, positive, cancelled}}#);
      data: [<Object, JSON, numeric::legacyDecimal::Source, '{"n":9007199254740993,"i":9007199254740993,"f":1.0,"optional":null,"repeated":[1.25e-3,9007199254740993],"unrelated":1.234567890123456789}'>];
      assert: '{"n":9007199254740993,"i":9007199254740993,"f":1.0,"optional":null,"repeated":[0.00125,9007199254740993],"unrelated":1.234567890123456789,"positive":true,"cancelled":0}';
    ),
    longMaximum
    (
      query: |numeric::legacyDecimal::Target.all()->graphFetch(#{numeric::legacyDecimal::Target{n, i, f, optional, repeated, unrelated, positive, cancelled}}#)->serialize(#{numeric::legacyDecimal::Target{n, i, f, optional, repeated, unrelated, positive, cancelled}}#);
      data: [<Object, JSON, numeric::legacyDecimal::Source, '{"n":9223372036854775807,"i":9223372036854775807,"f":1.0,"optional":null,"repeated":[1.25e-3,9007199254740993],"unrelated":1.234567890123456789}'>];
      assert: '{"n":9223372036854775807,"i":9223372036854775807,"f":1.0,"optional":null,"repeated":[0.00125,9007199254740993],"unrelated":1.234567890123456789,"positive":true,"cancelled":0}';
    ),
    longMinimum
    (
      query: |numeric::legacyDecimal::Target.all()->graphFetch(#{numeric::legacyDecimal::Target{n, i, f, optional, repeated, unrelated, positive, cancelled}}#)->serialize(#{numeric::legacyDecimal::Target{n, i, f, optional, repeated, unrelated, positive, cancelled}}#);
      data: [<Object, JSON, numeric::legacyDecimal::Source, '{"n":-9223372036854775808,"i":-9223372036854775808,"f":-1.0,"optional":null,"repeated":[1.25e-3,9007199254740993],"unrelated":1.234567890123456789}'>];
      assert: '{"n":-9223372036854775808,"i":-9223372036854775808,"f":-1.0,"optional":null,"repeated":[0.00125,9007199254740993],"unrelated":1.234567890123456789,"positive":false,"cancelled":0}';
    ),
    highPrecision
    (
      query: |numeric::legacyDecimal::Target.all()->graphFetch(#{numeric::legacyDecimal::Target{n, i, f, optional, repeated, unrelated, positive, cancelled}}#)->serialize(#{numeric::legacyDecimal::Target{n, i, f, optional, repeated, unrelated, positive, cancelled}}#);
      data: [<Object, JSON, numeric::legacyDecimal::Source, '{"n":1.2345678901234567890123456789e-3,"i":1,"f":1.0,"optional":null,"repeated":[1.25e-3,9007199254740993],"unrelated":1.234567890123456789}'>];
      assert: '{"n":0.0012345678901234567890123456789,"i":1,"f":1.0,"optional":null,"repeated":[0.00125,9007199254740993],"unrelated":1.234567890123456789,"positive":true,"cancelled":0E-31}';
    ),
    wideNumber
    (
      query: |numeric::legacyDecimal::Target.all()->graphFetch(#{numeric::legacyDecimal::Target{n, i, f, optional, repeated, unrelated, positive, cancelled}}#)->serialize(#{numeric::legacyDecimal::Target{n, i, f, optional, repeated, unrelated, positive, cancelled}}#);
      data: [<Object, JSON, numeric::legacyDecimal::Source, '{"n":9223372036854775808,"i":1,"f":1.0,"optional":null,"repeated":[1.25e-3,9007199254740993],"unrelated":1.234567890123456789}'>];
      assert: '{"n":9223372036854775808,"i":1,"f":1.0,"optional":null,"repeated":[0.00125,9007199254740993],"unrelated":1.234567890123456789,"positive":true,"cancelled":0}';
    )
  ]
)
