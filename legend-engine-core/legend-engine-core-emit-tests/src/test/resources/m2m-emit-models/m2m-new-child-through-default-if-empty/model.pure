###Pure
Class demo::m2m::newInstance::throughFunction::Leaf { id: String[1]; }
Class demo::m2m::newInstance::throughFunction::Detail { somevalue: String[1]; }
Class demo::m2m::newInstance::throughFunction::Special extends demo::m2m::newInstance::throughFunction::Leaf { somevalue: demo::m2m::newInstance::throughFunction::Detail[1]; }
Class demo::m2m::newInstance::throughFunction::Source { aDecoy: demo::m2m::newInstance::throughFunction::Leaf[1]; elements: demo::m2m::newInstance::throughFunction::Leaf[*]; }
Class demo::m2m::newInstance::throughFunction::Box { ft: demo::m2m::newInstance::throughFunction::Leaf[1]; }
Class demo::m2m::newInstance::throughFunction::Target2 { targets: demo::m2m::newInstance::throughFunction::Target[*]; }
Class demo::m2m::newInstance::throughFunction::Target { id: String[1]; val1: String[1]; }

###Mapping
Mapping demo::m2m::newInstance::throughFunction::Transform
(
  *demo::m2m::newInstance::throughFunction::Target2: Pure
  {
    ~src demo::m2m::newInstance::throughFunction::Source
    targets[target]: $src.elements->map(e | ^demo::m2m::newInstance::throughFunction::Box(ft=$e))->defaultIfEmpty(^demo::m2m::newInstance::throughFunction::Box(ft=$src.aDecoy))
  }
  demo::m2m::newInstance::throughFunction::Target[target]: Pure
  {
    ~src demo::m2m::newInstance::throughFunction::Box
    id: $src.ft.id,
    val1: $src.ft->cast(@demo::m2m::newInstance::throughFunction::Special).somevalue.somevalue
  }
)

###Runtime
Runtime demo::m2m::newInstance::throughFunction::TransformRuntime
{
  mappings:
  [
    demo::m2m::newInstance::throughFunction::Transform
  ];
  connections:
  [
    ModelStore:
    [
      json:
      #{
        JsonModelConnection
        {
          class: demo::m2m::newInstance::throughFunction::Source;
          url: 'executor:default';
        }
      }#
    ]
  ];
}

###Service
Service demo::m2m::newInstance::throughFunction::TransformService
{
  pattern: '/m2m-new-child-through-default-if-empty';
  documentation: 'M2M child mapping reads constructed instances passed through defaultIfEmpty';
  autoActivateUpdates: true;
  execution: Single
  {
    query: |demo::m2m::newInstance::throughFunction::Target2.all()->graphFetch(#{demo::m2m::newInstance::throughFunction::Target2{targets{id,val1}}}#)->serialize(#{demo::m2m::newInstance::throughFunction::Target2{targets{id,val1}}}#);
    mapping: demo::m2m::newInstance::throughFunction::Transform;
    runtime: demo::m2m::newInstance::throughFunction::TransformRuntime;
  }
  testSuites:
  [
    suite:
    {
      data:
      [
        connections:
        [
          json:
            ExternalFormat
            #{
              contentType: 'application/json';
              data: '{"aDecoy":{"@type":"Special","id":"DECOY","somevalue":{"somevalue":"wrong"}},"elements":[{"@type":"Special","id":"E1","somevalue":{"somevalue":"first"}},{"@type":"Special","id":"E2","somevalue":{"somevalue":"second"}}]}';
            }#
        ]
      ]
      tests:
      [
        test:
        {
          serializationFormat: PURE;
          asserts:
          [
            expected:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"targets":[{"id":"E1","val1":"first"},{"id":"E2","val1":"second"}]}';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
