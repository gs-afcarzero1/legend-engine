###Pure
Class demo::m2m::functionArgs::source::S_Leaf
{
  id: String[1];
  label: String[1];
  rank: Integer[1];
  kids: demo::m2m::functionArgs::source::S_Leaf[*];
  tagged(prefix: String[1]) { $prefix + $this.label + $this.kids.label->joinStrings('') }: String[1];
}

Class demo::m2m::functionArgs::source::S_Row
{
  id: String[1];
  index: Integer[1];
  end: Integer[1];
  name: String[1];
  one: demo::m2m::functionArgs::source::S_Leaf[1];
  two: demo::m2m::functionArgs::source::S_Leaf[1];
  many: demo::m2m::functionArgs::source::S_Leaf[*];
}

Class demo::m2m::functionArgs::target::Row
{
  id: String[1];
  picked: String[1];
  window: String[*];
  total: Integer[1];
  tagged: String[1];
  pair: demo::m2m::functionArgs::target::Named[*];
}

Class demo::m2m::functionArgs::target::Named
{
  name: String[1];
}


###Mapping
Mapping demo::m2m::functionArgs::RowMapping
(
  *demo::m2m::functionArgs::target::Row: Pure
  {
    ~src demo::m2m::functionArgs::source::S_Row
    id: $src.id,
    picked: $src.many->at($src.index).label,
    window: $src.many->slice($src.index, $src.end).label,
    total: $src.many->fold({leaf, acc | $acc + $leaf.rank}, $src.index),
    tagged: $src.one.tagged($src.name),
    pair[named]: $src.one->concatenate($src.two)
  }

  demo::m2m::functionArgs::target::Named[named]: Pure
  {
    ~src demo::m2m::functionArgs::source::S_Leaf
    name: $src.label
  }

  testSuites:
  [
    argumentSuite:
    {
      function: |demo::m2m::functionArgs::target::Row.all()->graphFetch(#{demo::m2m::functionArgs::target::Row{id, picked, window, total, tagged, pair{name}}}#)->serialize(#{demo::m2m::functionArgs::target::Row{id, picked, window, total, tagged, pair{name}}}#);
      tests:
      [
        readsEveryArgument:
        {
          data:
          [
            ModelStore: ModelStore
              #{
                demo::m2m::functionArgs::source::S_Row:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"id":"a","index":1,"end":2,"name":"x-","one":{"id":"o1","label":"O1","rank":5,"kids":[{"id":"k1","label":"K1","rank":1,"kids":[]}]},"two":{"id":"t1","label":"T1","rank":6,"kids":[]},"many":[{"id":"m1","label":"L1","rank":3,"kids":[]},{"id":"m2","label":"L2","rank":1,"kids":[]},{"id":"m3","label":"L3","rank":2,"kids":[]}]},{"id":"b","index":0,"end":1,"name":"y-","one":{"id":"o2","label":"O2","rank":7,"kids":[]},"two":{"id":"t2","label":"T2","rank":8,"kids":[]},"many":[{"id":"m4","label":"L4","rank":9,"kids":[]}]}]';
                  }#
              }#
          ];
          asserts:
          [
            expected:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"id":"a","picked":"L2","window":["L2"],"total":7,"tagged":"x-O1K1","pair":[{"name":"O1"},{"name":"T1"}]},{"id":"b","picked":"L4","window":["L4"],"total":9,"tagged":"y-O2","pair":[{"name":"O2"},{"name":"T2"}]}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)
