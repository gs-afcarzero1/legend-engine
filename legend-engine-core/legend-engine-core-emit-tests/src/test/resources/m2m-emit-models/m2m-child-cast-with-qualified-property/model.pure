###Pure
Class demo::m2m::cast::qualifiedProperty::Leaf { id: String[1]; identifier() { $this.id }: String[1]; }
Class demo::m2m::cast::qualifiedProperty::Detail { somevalue: String[1]; }
Class demo::m2m::cast::qualifiedProperty::Special extends demo::m2m::cast::qualifiedProperty::Leaf { somevalue: demo::m2m::cast::qualifiedProperty::Detail[1]; }
Class demo::m2m::cast::qualifiedProperty::Source { aDecoy: demo::m2m::cast::qualifiedProperty::Leaf[1]; primary: demo::m2m::cast::qualifiedProperty::Leaf[1]; }
Class demo::m2m::cast::qualifiedProperty::Target2 { targets: demo::m2m::cast::qualifiedProperty::Target[*]; }
Class demo::m2m::cast::qualifiedProperty::Target { id: String[1]; val1: String[1]; }

###Mapping
Mapping demo::m2m::cast::qualifiedProperty::Transform
(
  *demo::m2m::cast::qualifiedProperty::Target2: Pure
  {
    ~src demo::m2m::cast::qualifiedProperty::Source
    targets[target]: $src.primary
  }
  demo::m2m::cast::qualifiedProperty::Target[target]: Pure
  {
    ~src demo::m2m::cast::qualifiedProperty::Leaf
    id: $src.identifier(),
    val1: $src->cast(@demo::m2m::cast::qualifiedProperty::Special).somevalue.somevalue
  }
)

###Runtime
Runtime demo::m2m::cast::qualifiedProperty::TransformRuntime
{
  mappings:
  [
    demo::m2m::cast::qualifiedProperty::Transform
  ];
  connections:
  [
    ModelStore:
    [
      json:
      #{
        JsonModelConnection
        {
          class: demo::m2m::cast::qualifiedProperty::Source;
          url: 'executor:default';
        }
      }#
    ]
  ];
}

###Service
Service demo::m2m::cast::qualifiedProperty::TransformService
{
  pattern: '/m2m-child-cast-with-qualified-property';
  documentation: 'M2M child mapping keeps a cast read alongside a qualified property';
  autoActivateUpdates: true;
  execution: Single
  {
    query: |demo::m2m::cast::qualifiedProperty::Target2.all()->graphFetch(#{demo::m2m::cast::qualifiedProperty::Target2{targets{val1,id}}}#)->serialize(#{demo::m2m::cast::qualifiedProperty::Target2{targets{val1,id}}}#);
    mapping: demo::m2m::cast::qualifiedProperty::Transform;
    runtime: demo::m2m::cast::qualifiedProperty::TransformRuntime;
  }
  testSuites:
  [
    suite:
    {
      data:
      [
        connections:
        [
          json:
            ExternalFormat
            #{
              contentType: 'application/json';
              data: '{"aDecoy":{"@type":"Special","id":"DECOY","somevalue":{"somevalue":"wrong"}},"primary":{"@type":"Special","id":"PRIMARY","somevalue":{"somevalue":"value"}}}';
            }#
        ]
      ]
      tests:
      [
        test:
        {
          serializationFormat: PURE;
          asserts:
          [
            expected:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"targets":[{"val1":"value","id":"PRIMARY"}]}';
                  }#;
              }#
          ]
        }
      ]
    }
  ]
}
