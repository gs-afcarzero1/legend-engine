    {
      function: |demo::m2m::constructed::target::Summary.all()->graphFetch(#{demo::m2m::constructed::target::Summary{id,values}}#)->serialize(#{demo::m2m::constructed::target::Summary{id,values}}#);
      tests:
      [
        sparseSource:
        {
          data:
          [
            ModelStore: ModelStore
              #{
                demo::m2m::constructed::source::Customer:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"id":"c1","name":"Ann","address":{"street":"main st"}},{"id":"c2","name":"Bob","address":{"street":"side ln"}}]';
                  }#
              }#
          ];
          asserts:
          [
            expected:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"id":"c1","values":["main st"]},{"id":"c2","values":["side ln"]}]';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)


// The constructor is only used by the class filter.
###Mapping
Mapping demo::m2m::constructed::Filter
(
  demo::m2m::constructed::target::Summary: Pure
  {
    ~src demo::m2m::constructed::source::Customer
    ~filter $src->demo::m2m::constructed::normalise().street == 'MAIN ST'
    id: $src.id,
    values: $src.address.street
  }

  testSuites:
  [
    summaries:
    {
      function: |demo::m2m::constructed::target::Summary.all()->graphFetch(#{demo::m2m::constructed::target::Summary{id,values}}#)->serialize(#{demo::m2m::constructed::target::Summary{id,values}}#);
      tests:
      [
        sparseSource:
        {
          data:
          [
            ModelStore: ModelStore
              #{
                demo::m2m::constructed::source::Customer:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '[{"id":"c1","name":"Ann","address":{"street":"main st"}},{"id":"c2","name":"Bob","address":{"street":"side ln"}}]';
                  }#
              }#
          ];
          asserts:
          [
            expected:
              EqualToJson
              #{
                expected:
                  ExternalFormat
                  #{
                    contentType: 'application/json';
                    data: '{"id":"c1","values":["main st"]}';
                  }#;
              }#
          ];
        }
      ];
    }
  ]
)


