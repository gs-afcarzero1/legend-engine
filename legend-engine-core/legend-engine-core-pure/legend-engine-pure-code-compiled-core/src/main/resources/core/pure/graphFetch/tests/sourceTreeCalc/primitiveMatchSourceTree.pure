###Pure
import meta::pure::graphFetch::*;
import meta::pure::lineage::scanProperties::test::primitiveMatch::*;

Class meta::pure::lineage::scanProperties::test::primitiveMatch::Src { id: String[1]; kind: String[1]; }
Class meta::pure::lineage::scanProperties::test::primitiveMatch::Tgt { id: String[1]; label: String[1]; }
function meta::pure::lineage::scanProperties::test::primitiveMatch::labelOf(s: Src[1]): String[1] { $s.kind->match([k: String[1] | 'kind-' + $k]) }

function <<test.Test>> meta::pure::lineage::scanProperties::test::primitiveMatch::testMatchOnPrimitiveInTransform():Boolean[1]
{
  let actual = calculateSourceTree(#{Tgt{id,label}}#, inlineMatch, meta::pure::extension::defaultExtensions());
  assertEquals(#{Src{id, kind}}#->sortTree()->treeToString(), $actual->sortTree()->treeToString());
}

function <<test.Test>> meta::pure::lineage::scanProperties::test::primitiveMatch::testMatchOnPrimitiveInHelper():Boolean[1]
{
  let actual = calculateSourceTree(#{Tgt{id,label}}#, helperMatch, meta::pure::extension::defaultExtensions());
  assertEquals(#{Src{id, kind}}#->sortTree()->treeToString(), $actual->sortTree()->treeToString());
}

###Mapping
import meta::pure::lineage::scanProperties::test::primitiveMatch::*;
Mapping meta::pure::lineage::scanProperties::test::primitiveMatch::inlineMatch
(
  Tgt: Pure { ~src Src id: $src.id, label: $src.kind->match([k: String[1] | 'kind-' + $k]) }
)

Mapping meta::pure::lineage::scanProperties::test::primitiveMatch::helperMatch
(
  Tgt: Pure { ~src Src id: $src.id, label: $src->labelOf() }
)
