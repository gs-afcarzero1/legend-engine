###Pure
import meta::pure::graphFetch::*;
import meta::pure::graphFetch::tests::sourceTreeCalc::constructorCurrent::*;
Class meta::pure::graphFetch::tests::sourceTreeCalc::constructorCurrent::Leaf { id: String[1]; }
Class meta::pure::graphFetch::tests::sourceTreeCalc::constructorCurrent::Source { aDecoy: Leaf[1]; primary: Leaf[1]; }
Class meta::pure::graphFetch::tests::sourceTreeCalc::constructorCurrent::Box { ft: Leaf[1]; }
Class meta::pure::graphFetch::tests::sourceTreeCalc::constructorCurrent::Target { value: String[1]; }

function <<test.Test>> meta::pure::graphFetch::tests::sourceTreeCalc::constructorCurrent::testInlineConstructorCurrent():Boolean[1]
{
  let actual = calculateSourceTree(#{Target {value}}#, inlineMapping, meta::pure::extension::defaultExtensions());
  assertEquals(#{Source {primary {id}}}#->sortTree()->treeToString(), $actual->sortTree()->treeToString());
}

###Mapping
import meta::pure::graphFetch::tests::sourceTreeCalc::constructorCurrent::*;
Mapping meta::pure::graphFetch::tests::sourceTreeCalc::constructorCurrent::inlineMapping
(
  *Target: Pure { ~src Source value: ^Box(ft=$src.primary).ft.id }
)

###Pure
import meta::pure::graphFetch::*;
import meta::pure::graphFetch::tests::sourceTreeCalc::constructorCurrent::child::*;
Class meta::pure::graphFetch::tests::sourceTreeCalc::constructorCurrent::child::Leaf { id: String[1]; }
Class meta::pure::graphFetch::tests::sourceTreeCalc::constructorCurrent::child::Detail { somevalue: String[1]; }
Class meta::pure::graphFetch::tests::sourceTreeCalc::constructorCurrent::child::Special extends Leaf { somevalue: Detail[1]; }
Class meta::pure::graphFetch::tests::sourceTreeCalc::constructorCurrent::child::Source { aDecoy: Leaf[1]; elements: Leaf[*]; }
Class meta::pure::graphFetch::tests::sourceTreeCalc::constructorCurrent::child::Box { ft: Leaf[1]; }
Class meta::pure::graphFetch::tests::sourceTreeCalc::constructorCurrent::child::Target { targets: Item[*]; }
Class meta::pure::graphFetch::tests::sourceTreeCalc::constructorCurrent::child::Item { id: String[1]; val1: String[1]; }

function <<test.Test>> meta::pure::graphFetch::tests::sourceTreeCalc::constructorCurrent::child::testChildMappingReadsThroughConstructedCurrent():Boolean[1]
{
  let actual = calculateSourceTree(#{Target {targets {id, val1}}}#, childMapping, meta::pure::extension::defaultExtensions());
  assertEquals(#{Source {elements {id}, elements->subType(@Special) {id, somevalue {somevalue}}}}#->sortTree()->treeToString(), $actual->sortTree()->treeToString());
}

###Mapping
import meta::pure::graphFetch::tests::sourceTreeCalc::constructorCurrent::child::*;
Mapping meta::pure::graphFetch::tests::sourceTreeCalc::constructorCurrent::child::childMapping
(
  *Target: Pure { ~src Source targets[item]: $src.elements->map(e | ^Box(ft=$e)) }
  Item[item]: Pure { ~src Box id: $src.ft.id, val1: $src.ft->cast(@Special).somevalue.somevalue }
)

###Pure
import meta::pure::graphFetch::*;
import meta::pure::graphFetch::tests::sourceTreeCalc::constructorCurrent::alternatives::*;
Class meta::pure::graphFetch::tests::sourceTreeCalc::constructorCurrent::alternatives::Leaf { id: String[1]; }
Class meta::pure::graphFetch::tests::sourceTreeCalc::constructorCurrent::alternatives::Source { choice: String[1]; aDecoy: Leaf[*]; primary: Leaf[*]; secondary: Leaf[*]; }
Class meta::pure::graphFetch::tests::sourceTreeCalc::constructorCurrent::alternatives::Box { ft: Leaf[*]; }
Class meta::pure::graphFetch::tests::sourceTreeCalc::constructorCurrent::alternatives::Target { item: Item[*]; }
Class meta::pure::graphFetch::tests::sourceTreeCalc::constructorCurrent::alternatives::Item { ids: String[*]; }

function <<test.Test>> meta::pure::graphFetch::tests::sourceTreeCalc::constructorCurrent::alternatives::testMapOverConditionalBindsEachBranch():Boolean[1]
{
  let actual = calculateSourceTree(#{Target {item {ids}}}#, mapOverConditionalMapping, meta::pure::extension::defaultExtensions());
  assertEquals(#{Source {choice, primary {id}, secondary {id}}}#->sortTree()->treeToString(), $actual->sortTree()->treeToString());
}

function <<test.Test>> meta::pure::graphFetch::tests::sourceTreeCalc::constructorCurrent::alternatives::testConditionalAssignmentBindsEachBranch():Boolean[1]
{
  let actual = calculateSourceTree(#{Target {item {ids}}}#, conditionalAssignmentMapping, meta::pure::extension::defaultExtensions());
  assertEquals(#{Source {choice, primary {id}, secondary {id}}}#->sortTree()->treeToString(), $actual->sortTree()->treeToString());
}

###Mapping
import meta::pure::graphFetch::tests::sourceTreeCalc::constructorCurrent::alternatives::*;
Mapping meta::pure::graphFetch::tests::sourceTreeCalc::constructorCurrent::alternatives::mapOverConditionalMapping
(
  *Target: Pure { ~src Source item[item]: if($src.choice == 'primary', |$src.primary, |$src.secondary)->map(e | ^Box(ft=$e)) }
  Item[item]: Pure { ~src Box ids: $src.ft.id }
)

Mapping meta::pure::graphFetch::tests::sourceTreeCalc::constructorCurrent::alternatives::conditionalAssignmentMapping
(
  *Target: Pure { ~src Source item[item]: ^Box(ft=if($src.choice == 'primary', |$src.primary, |$src.secondary)) }
  Item[item]: Pure { ~src Box ids: $src.ft.id }
)

###Pure
import meta::pure::graphFetch::*;
import meta::pure::graphFetch::tests::sourceTreeCalc::constructorCurrent::filter::*;
Class meta::pure::graphFetch::tests::sourceTreeCalc::constructorCurrent::filter::Leaf { id: String[1]; rank: Integer[1]; }
Class meta::pure::graphFetch::tests::sourceTreeCalc::constructorCurrent::filter::Source { aDecoy: Leaf[1]; elements: Leaf[*]; }
Class meta::pure::graphFetch::tests::sourceTreeCalc::constructorCurrent::filter::Box { ft: Leaf[1]; }
Class meta::pure::graphFetch::tests::sourceTreeCalc::constructorCurrent::filter::Target { targets: Item[*]; }
Class meta::pure::graphFetch::tests::sourceTreeCalc::constructorCurrent::filter::Item { id: String[1]; }

function <<test.Test>> meta::pure::graphFetch::tests::sourceTreeCalc::constructorCurrent::filter::testChildFilterReadsThroughConstructedCurrent():Boolean[1]
{
  let actual = calculateSourceTree(#{Target {targets {id}}}#, filterMapping, meta::pure::extension::defaultExtensions());
  assertEquals(#{Source {elements {id, rank}}}#->sortTree()->treeToString(), $actual->sortTree()->treeToString());
}

###Mapping
import meta::pure::graphFetch::tests::sourceTreeCalc::constructorCurrent::filter::*;
Mapping meta::pure::graphFetch::tests::sourceTreeCalc::constructorCurrent::filter::filterMapping
(
  *Target: Pure { ~src Source targets[item]: $src.elements->map(e | ^Box(ft=$e)) }
  Item[item]: Pure { ~src Box ~filter $src.ft.rank > 1 id: $src.ft.id }
)
