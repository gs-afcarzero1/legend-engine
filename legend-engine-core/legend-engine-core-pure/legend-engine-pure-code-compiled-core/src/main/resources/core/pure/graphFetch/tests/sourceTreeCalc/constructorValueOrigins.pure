###Pure
import meta::pure::lineage::scanProperties::test::constructorOrigins::*;
import meta::pure::graphFetch::*;
Class meta::pure::lineage::scanProperties::test::constructorOrigins::Root
{
  primary: Leaf[1];
  secondary: Leaf[1];
  elements: Leaf[*];
  choose: Boolean[1];
  index: Integer[1];
  end: Integer[1];
  extra: String[1];
}
Class meta::pure::lineage::scanProperties::test::constructorOrigins::Leaf
{
  id: String[1];
  label: String[1];
  rank: Integer[1];
  children: Leaf[*];
  decorated(prefix:String[1]) { $prefix + $this.label; }: String[1];
}
Class meta::pure::lineage::scanProperties::test::constructorOrigins::Detail { value: String[1]; }
Class meta::pure::lineage::scanProperties::test::constructorOrigins::Box { ft: Leaf[1]; owner: Root[0..1]; stamp: String[0..1]; }
Class meta::pure::lineage::scanProperties::test::constructorOrigins::DerivedBox extends Box { extraLeaf: Leaf[0..1]; }
Class meta::pure::lineage::scanProperties::test::constructorOrigins::Outer { inner: Box[1]; }
Class meta::pure::lineage::scanProperties::test::constructorOrigins::TwoSlots { left: Leaf[1]; right: Leaf[1]; }
Class meta::pure::lineage::scanProperties::test::constructorOrigins::Target { items: Item[*]; }
Class meta::pure::lineage::scanProperties::test::constructorOrigins::Item { id: String[1]; label: String[1]; }
Class meta::pure::lineage::scanProperties::test::constructorOrigins::ScalarTarget { value: String[*]; }
Class meta::pure::lineage::scanProperties::test::constructorOrigins::Bag { leaves: Leaf[*]; }
function meta::pure::lineage::scanProperties::test::constructorOrigins::box(x:Leaf[1]):Box[1] { ^Box(ft=$x); }
function meta::pure::lineage::scanProperties::test::constructorOrigins::choose(x:Root[1]):Leaf[1] { if($x.choose, |$x.primary, |$x.secondary); }
function meta::pure::lineage::scanProperties::test::constructorOrigins::read(x:Box[1]):String[1] { $x.ft.id; }
function meta::pure::lineage::scanProperties::test::constructorOrigins::nested(x:Root[1]):Outer[1] { ^Outer(inner=^Box(ft=$x.primary)); }

function <<test.Test>> meta::pure::lineage::scanProperties::test::constructorOrigins::testdirect():Boolean[1]
{
  let actual = calculateSourceTree(#{Target {items {id,label}}}#, meta::pure::lineage::scanProperties::test::constructorOrigins::mappingdirect, meta::pure::extension::defaultExtensions());
  assertEquals(#{Root {primary {id,label}}}#->sortTree()->treeToString(), $actual->sortTree()->treeToString());
}
###Mapping
import meta::pure::lineage::scanProperties::test::constructorOrigins::*;
Mapping meta::pure::lineage::scanProperties::test::constructorOrigins::mappingdirect
(
  *Target: Pure { ~src Root items[item]: ^Box(ft=$src.primary) }
  Item[item]: Pure { ~src Box id: $src.ft.id, label: $src.ft.label }
)
