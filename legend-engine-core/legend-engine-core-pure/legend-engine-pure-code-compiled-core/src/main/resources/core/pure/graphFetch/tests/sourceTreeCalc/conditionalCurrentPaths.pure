    |$source->meta::pure::lineage::scanProperties::test::sourceTreeConditionalCurrents::returnNoIdentitySource()
  );
}

function meta::pure::lineage::scanProperties::test::sourceTreeConditionalCurrents::identityMany(sources:IdentitySource[*]):IdentitySource[*]
{
  $sources;
}

function meta::pure::lineage::scanProperties::test::sourceTreeConditionalCurrents::selectThenNavigate(source:IdentitySource[1]):IdentitySource[*]
{
  if($source.chooseChildren, |$source.children, |$source).children;
}

