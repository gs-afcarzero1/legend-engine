}

function meta::pure::lineage::scanProperties::test::sourceTreeConditionalCurrents::selectThroughTwoConditionalCollections(source:IdentitySource[1]):IdentitySource[*]
{
  $source->meta::pure::lineage::scanProperties::test::sourceTreeConditionalCurrents::selectChildrenOrSource()
    ->concatenate(if($source.chooseGrandChildren, |$source.children.children, |[$source.secondary]));
}

function <<test.Test>> meta::pure::mapping::modelToModel::test::sourceTreeConditionalCurrents::testIdentityEndpointIsRetained():Boolean[1]
{
  let targetTree = #{IdentityTarget {items {name}}}#;
  let expectedSourceTree = #{IdentitySource {chooseChildren, name, children {name}}}#;
  let actualSourceTree = calculateSourceTree($targetTree, identityMapping, meta::pure::extension::defaultExtensions());
  assertEquals($expectedSourceTree->sortTree()->treeToString(), $actualSourceTree->sortTree()->treeToString());
}

