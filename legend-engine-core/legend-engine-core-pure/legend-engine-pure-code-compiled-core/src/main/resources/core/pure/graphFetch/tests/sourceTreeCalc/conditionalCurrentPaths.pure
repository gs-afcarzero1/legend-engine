{
  $source->meta::pure::lineage::scanProperties::test::sourceTreeConditionalCurrents::selectChildrenOrSource()
    ->sort({left, right | $left.name->compare($right.name)});
}

function meta::pure::lineage::scanProperties::test::sourceTreeConditionalCurrents::selectThroughNestedLetNavigation(source:IdentitySource[1]):IdentitySource[*]
{
