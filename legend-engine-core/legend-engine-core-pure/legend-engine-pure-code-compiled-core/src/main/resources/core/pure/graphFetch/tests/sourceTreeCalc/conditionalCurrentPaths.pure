###Pure
import meta::pure::graphFetch::*;
import meta::pure::mapping::modelToModel::test::sourceTreeConditionalCurrents::*;

Class meta::pure::mapping::modelToModel::test::sourceTreeConditionalCurrents::IdentitySource
{
  chooseChildren : Boolean[1];
  chooseGrandChildren : Boolean[1];
  name : String[1];
  rank : Integer[1];
  children : IdentitySource[*];
  primary : IdentitySource[1];
  secondary : IdentitySource[1];

  nonEmptyChildren()
  {
    $this.children->filter(child | $child.name->isNotEmpty());
  }: IdentitySource[*];

  descendantNames()
  {
    $this.children.name;
  }: String[*];
}

Class meta::pure::mapping::modelToModel::test::sourceTreeConditionalCurrents::IdentityTarget
{
  items : IdentityItem[*];
  otherItems : IdentityItem[*];
  primaryItems : IdentityItem[*];
  secondaryItems : IdentityItem[*];
  names : String[*];
  hasRanked : Boolean[1];
}

Class meta::pure::mapping::modelToModel::test::sourceTreeConditionalCurrents::IdentityItem
{
  name : String[1];
}

function meta::pure::lineage::scanProperties::test::sourceTreeConditionalCurrents::selectChildrenOrSource(source:IdentitySource[1]):IdentitySource[*]
{
  if($source.chooseChildren, |$source.children, |$source);
}

function meta::pure::lineage::scanProperties::test::sourceTreeConditionalCurrents::selectNestedIdentityEndpoints(source:IdentitySource[1]):IdentitySource[*]
{
  if($source.chooseChildren,
    |if($source.chooseGrandChildren, |$source.children.children, |$source.children),
    |$source
  );
}

function meta::pure::lineage::scanProperties::test::sourceTreeConditionalCurrents::delegateIdentitySelection(source:IdentitySource[1]):IdentitySource[*]
{
  $source->meta::pure::lineage::scanProperties::test::sourceTreeConditionalCurrents::selectChildrenOrSource();
}

function meta::pure::lineage::scanProperties::test::sourceTreeConditionalCurrents::returnNoIdentitySource(source:IdentitySource[1]):IdentitySource[*]
{
