###Pure
Class numeric::input::Child
{
  value: Decimal[1];
}
Class numeric::input::Document
{
  d: Decimal[1];
  n: Number[1];
  i: Integer[1];
  f: Float[1];
  child: numeric::input::Child[0..1];
  values: Decimal[*];
  empty: Decimal[*];
  label: String[0..1];
}
###Mapping
Mapping numeric::input::Mapping ()
###Runtime
Runtime numeric::input::Runtime
{
  mappings: [numeric::input::Mapping];
}
###ExternalFormat
Binding numeric::input::Binding
{
  contentType: 'application/json';
  modelIncludes: [numeric::input::Document, numeric::input::Child];
}
###Service
Service numeric::input::Graph
{
  pattern: '/numeric/scientific-json-input/Graph';
  documentation: 'Exact numeric JSON through Graph.';
  autoActivateUpdates: true;
  execution: Single
  {
    query: |numeric::input::Document->internalize(numeric::input::Binding, '[{"d":1e400,"n":9007199254740993,"i":9223372036854775807,"f":1.25e-3,"child":{"value":1.2345678901234567890123456789},"values":[1e-400,-2.5E+2],"empty":[],"label":"ordinary control"},{"d":1e-400,"n":1.25e-3,"i":-9223372036854775808,"f":-2.5E+2,"child":null,"values":[],"empty":[],"label":null}]')->graphFetch(#{numeric::input::Document{d, n, i, f, child{value}, values, empty, label}}#)->serialize(#{numeric::input::Document{d, n, i, f, child{value}, values, empty, label}}#);
    mapping: numeric::input::Mapping;
    runtime: numeric::input::Runtime;
  }
  testSuites:
  [
    numericSuite:
    {
      tests:
      [
        preservesNumbers:
        {
          asserts:
          [
            exact: EqualToJson
              #{ expected: ExternalFormat #{ contentType: 'application/json'; data: '{"builder":{"_type":"json"},"values":[{"d":1e400,"n":9007199254740993,"i":9223372036854775807,"f":1.25e-3,"child":{"value":1.2345678901234567890123456789},"values":[1e-400,-2.5E+2],"empty":[],"label":"ordinary control"},{"d":1e-400,"n":1.25e-3,"i":-9223372036854775808,"f":-2.5E+2,"child":null,"values":[],"empty":[],"label":null}]}'; }#; }#
          ]
        }
      ]
    }
  ]
}

###Service
